# .env.example
#
# Copy this to .env. The defaults below work out of the box with
# the docker-compose stack (`docker compose up -d --build`).
#
# If you want to run server/client outside Docker against the
# database containers, change the host names from service names
# (`mongo`, `neo4j`, `redis`) to `localhost`.

# Server
PORT=3000
NODE_ENV=production

# MongoDB (Docker container; use localhost:27017 outside Docker)
MONGO_URI=mongodb://synergyhack:dev_password@mongo:27017/synergyhack?authSource=admin
MONGO_DB=synergyhack

# Neo4j (Docker container; can be repointed at Aura by changing URI)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev_password

# Redis (Docker container; use redis://localhost:6379 outside Docker)
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=replace_with_random_string_in_production
JWT_EXPIRES_IN=24h

# OAuth / SSO (optional — leave blank to hide provider availability server-side)
# Create apps at Google Cloud Console and GitHub Developer Settings.
# Authorized redirect URIs must match OAUTH_CALLBACK_BASE_URL + /auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:8080/api
CLIENT_ORIGIN=http://localhost:8080
