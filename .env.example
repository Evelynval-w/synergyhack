# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=synergyhack

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_in_real_env

# Redis
REDIS_URL=redis://redis:6379

# Auth (Aadithya will use this)
JWT_SECRET=replace_with_random_string_in_real_env
JWT_EXPIRES_IN=24h
