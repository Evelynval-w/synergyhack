        </mxCell>
        <mxCell id="mongodb" value="MongoDB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="180" y="610" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mongo-driver" value="driver: mongodb npm package" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="180" y="725" width="200" height="18" as="geometry" />
        </mxCell>
        <mxCell id="mongo-details" value="&lt;b&gt;Document Store&lt;/b&gt;&#xa;&#xa;Collections:&#xa;• users (profile, bio, portfolio)&#xa;• teams (metadata, roster)&#xa;• hackathons (events, tracks)&#xa;• past_projects (write-ups, ratings)&#xa;&#xa;&lt;b&gt;Aggregation pipelines:&lt;/b&gt;&#xa;① Skill demand per role&#xa;   ($unwind → $group → $sort)&#xa;② Team composition patterns&#xa;   for successful projects (rating &gt; 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="100" y="760" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="neo4j" value="Neo4j ★" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="610" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="neo4j-driver" value="driver: neo4j-driver npm package" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="700" y="725" width="200" height="18" as="geometry" />
        </mxCell>
        <mxCell id="neo4j-details" value="&lt;b&gt;Graph Database — core value&lt;/b&gt;&#xa;&#xa;Nodes: User, Skill, Role, Team,&#xa;Hackathon, Project&#xa;&#xa;Relationships:&#xa;• HAS_SKILL {level, years}&#xa;• COMPLEMENTS {strength}  ← key&#xa;• MEMBER_OF&#xa;• WANTS_ROLE&#xa;• TEAMED_WITH {rating}&#xa;• PARTICIPATED_IN&#xa;&#xa;&lt;b&gt;Path traversal:&lt;/b&gt;&#xa;gap-coverage match query walks&#xa;team skills → COMPLEMENTS → candidate&#xa;skills, ranked by sum of edge weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="Redis" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="610" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="redis-driver" value="driver: redis npm package" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="1220" y="725" width="200" height="18" as="geometry" />
        </mxCell>
        <mxCell id="redis-details" value="&lt;b&gt;In-Memory Store&lt;/b&gt;&#xa;&#xa;&lt;b&gt;Data types in use:&lt;/b&gt;&#xa;• STRING  session:{token}  (TTL 24h)&#xa;• SET     online:users&#xa;• HASH    team:{id}:slots&#xa;           {capacity, filled}&#xa;• ZSET    leaderboard:matchers&#xa;• LIST    recent:joins (LTRIM 20)&#xa;&#xa;&lt;b&gt;Roles played:&lt;/b&gt;&#xa;• Session storage&#xa;• Presence tracking&#xa;• Atomic slot counters&#xa;• Pub/Sub for Socket.io&#xa;• Rate-limiting tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="1140" y="760" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" value="Key flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;dashed=1" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="legend-text" value="① Register → Mongo (profile) + Neo4j (User node)&#xa;② Find matches → Neo4j traversal → Mongo hydrate&#xa;③ Join team → Redis counter + Mongo + Neo4j edge&#xa;④ Online presence → Redis set + Socket.io broadcast" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=12;spacingTop=20" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="340" height="70" as="geometry" />
        </mxCell>
